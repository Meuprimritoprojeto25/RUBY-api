<% @title = "Finalizar compra" %>
<section class="shell checkout-page">
  <div class="breadcrumbs"><a href="/">Início</a><span>›</span><a href="/carrinho">Carrinho</a><span>›</span><b>Finalizar compra</b></div>
  <div class="checkout-layout"><form action="/pedidos" method="post" class="checkout-form"><%= csrf_field %><span class="overline">ÚLTIMA ETAPA</span><h1>Como devemos entregar?</h1><p class="checkout-intro">Preencha seus dados para confirmar a compra. Este checkout é uma demonstração segura.</p><label>Nome completo<input required name="customer_name" autocomplete="name" placeholder="Seu nome"></label><label>E-mail<input required type="email" name="customer_email" autocomplete="email" placeholder="voce@exemplo.com"></label><label>Endereço de entrega<textarea required name="address" autocomplete="street-address" placeholder="Rua, número, complemento, bairro, cidade e CEP"></textarea></label><div class="demo-payment"><span>▣</span><p><b>Pagamento aprovado com segurança</b><small>Ambiente demonstrativo — não informe dados de cartão.</small></p></div><button class="button button-blue" type="submit">Confirmar pedido · <%= money(cart_total) %></button></form><aside class="checkout-summary"><h2>Resumo do pedido</h2><% @items.each do |item| %><div class="mini-item"><img src="<%= h(item[:image_url]) %>" alt=""><p><%= h(item[:title]) %><small>Quantidade: <%= item[:quantity] %></small></p><b><%= money(item[:line_total_cents]) %></b></div><% end %><hr><p class="summary-total"><span>Total</span><b><%= money(cart_total) %></b></p><small>Frete grátis para todo o Brasil</small></aside></div>
</section>