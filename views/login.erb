<section class="auth-page">
  <div class="auth-card">
    <a class="brand auth-brand" href="/"><span class="brand-mark">v</span><span>mercado<span>viva</span></span></a>
    <p class="eyebrow">Que bom ter você de volta</p>
    <h1>Entre na sua conta</h1>
    <p class="auth-intro">Acesse seus favoritos, pedidos e anúncios.</p>
    <form class="form-stack" action="/entrar" method="post">
      <label>E-mail<input type="email" name="email" required autocomplete="email"></label>
      <label>Senha<input type="password" name="password" required autocomplete="current-password"></label>
      <button class="button button-primary button-wide" type="submit">Entrar</button>
    </form>
    <p class="auth-switch">Ainda não tem uma conta? <a href="/cadastro">Crie agora</a></p>
  </div>
</section>