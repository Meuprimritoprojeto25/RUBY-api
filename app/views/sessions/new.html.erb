<section class="auth-page"><div class="auth-card"><h1>Entre na sua conta</h1><p>Compre, venda e acompanhe seus pedidos.</p><%= form_with url: session_path do |form| %><%= form.label :email, "E-mail" %><%= form.email_field :email, required: true, autofocus: true %><%= form.label :password, "Senha" %><%= form.password_field :password, required: true %><%= form.submit "Entrar", class: "primary-button full-button" %><% end %><p class="auth-switch">Ainda não tem conta? <%= link_to "Crie agora", new_user_path %></p></div></section>
