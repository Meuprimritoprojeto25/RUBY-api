<% @title = "Entrar" %>
<section class="auth-page"><div class="auth-card"><a class="brand brand--small" href="/"><span>vitrine</span>livre</a><h1>Entre na sua conta</h1><p>Compre, venda e acompanhe seus pedidos.</p><% if @error %><div class="form-error"><%= h(@error) %></div><% end %><form method="post" action="/entrar" class="form-stack"><label>E-mail<input type="email" name="email" required autocomplete="email"></label><label>Senha<input type="password" name="password" required autocomplete="current-password"></label><button class="button button--wide" type="submit">Entrar</button></form><p class="auth-footer">Ainda não tem conta? <a href="/criar-conta">Criar conta grátis</a></p></div></section>