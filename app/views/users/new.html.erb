<section class="auth-page"><div class="auth-card"><h1>Crie sua conta</h1><p>É rápido, seguro e gratuito.</p><%= form_with model: @user do |form| %><% if @user.errors.any? %><div class="form-errors"><%= @user.errors.full_messages.to_sentence %></div><% end %><%= form.label :username, "Como podemos chamar você?" %><%= form.text_field :username, required: true %><%= form.label :email, "E-mail" %><%= form.email_field :email, required: true %><%= form.label :password, "Crie uma senha" %><%= form.password_field :password, required: true %><%= form.label :password_confirmation, "Confirme sua senha" %><%= form.password_field :password_confirmation, required: true %><%= form.submit "Criar conta", class: "primary-button full-button" %><% end %><p class="auth-switch">Já tem conta? <%= link_to "Entre", new_session_path %></p></div></section>
