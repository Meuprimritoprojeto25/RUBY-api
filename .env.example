# Optional database URL. Without it the application uses db/development.sqlite3.
# DATABASE_URL=sqlite3:db/development.sqlite3
SESSION_SECRET=replace-this-with-a-random-string-of-at-least-64-characters-before-production

# Set to true to bootstrap the administrator and marketplace demonstration data.
DASHBOARDIA_DEMO_MODE=true
DASHBOARDIA_DEMO_USERNAME=admin
DASHBOARDIA_DEMO_EMAIL=admin@mercadoviva.local
DASHBOARDIA_DEMO_PASSWORD=mercadoviva-demo